# Public base URL of your link shortener instance (used for short link display & self-loop prevention)
APP_BASE_URL=http://localhost:3000

# Database driver:
#   pglite - embedded PostgreSQL for local development / Docker (file-backed)
#   neon   - Neon serverless PostgreSQL for Vercel deployments
# Vercel deployments default to "neon" when VERCEL=1.
DATABASE_DRIVER=pglite

# Local: a directory for the embedded database, or memory:// for tests.
# Neon:  the full postgres://... connection string from your Neon project.
DATABASE_URL=./data/pgdata

# Generate ADMIN_PASSWORD_HASH using: npm run hash-password -- "your-strong-password"
# Format: scrypt:<hex-salt>:<hex-derived-key>
ADMIN_PASSWORD_HASH=

# 32+ byte secret used to sign HttpOnly admin session cookies and PoW challenges.
# Required in production; must be identical across all serverless instances.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional separate HMAC secret for stateless Proof-of-Work challenges (defaults to SESSION_SECRET)
POW_SECRET=

# Number of leading zero bits required for SHA-256 hashcash PoW (16 = ~65k hashes / ~30ms in browser)
POW_DIFFICULTY=16

# Default HTTP redirect status code for links without expiry/max-clicks (301 | 302 | 307)
DEFAULT_REDIRECT_CODE=302
