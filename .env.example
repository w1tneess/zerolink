# Public base URL of your link shortener instance (used for short link display & self-loop prevention)
APP_BASE_URL=http://localhost:3000

# Database driver: sqlite (default local), turso, or postgres
DATABASE_DRIVER=sqlite
DATABASE_URL=./data/links.db

# Generate ADMIN_PASSWORD_HASH using: npm run hash-password -- "your-strong-password"
# Format: scrypt:<hex-salt>:<hex-derived-key>
ADMIN_PASSWORD_HASH=

# 32+ byte secret used to sign HttpOnly admin session cookies and PoW challenges
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional separate HMAC secret for stateless Proof-of-Work challenges (defaults to SESSION_SECRET)
POW_SECRET=

# Number of leading zero bits required for SHA-256 hashcash PoW (16 = ~65k hashes / ~30ms in browser)
POW_DIFFICULTY=16

# Default HTTP redirect status code for links without expiry/max-clicks (301 | 302 | 307)
DEFAULT_REDIRECT_CODE=302
